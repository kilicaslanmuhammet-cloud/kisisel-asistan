# Firebase Konfigürasyonu
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google OAuth & API
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Anthropic Claude API
EXPO_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI Whisper API
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key

# Telegram Bot
EXPO_PUBLIC_TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Microsoft Graph API (Outlook)
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=your_microsoft_client_id
EXPO_PUBLIC_MICROSOFT_TENANT_ID=common

# OpenWeather API
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key
